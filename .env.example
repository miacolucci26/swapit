# =============================================================================================================
# Swap It — variables de entorno. Copia este archivo a apps/api/.env (desarrollo) o cárgalas en Vercel (producción).
# [SECRETO] = nunca al repositorio, nunca al navegador, nunca en capturas ni en el chat. En Vercel márcalas como «Sensitive».
# [PÚBLICO] = no es un secreto (el navegador la ve de todos modos).
# Hay dos proyectos Vercel: «swapit-api» (apps/api) y «swapit-web» (apps/web). Cada bloque dice a cuál pertenece.
# Detalle paso a paso: docs/despliegue.md
# =============================================================================================================

# ------------------------------------------------ API · base de datos (Supabase) ------------------------------------------------
# Conexión de la aplicación: el POOLER de Supabase (puerto 6543, modo transacción). Con pgbouncer=true y connection_limit=1 por función.
DATABASE_URL="postgresql://postgres.PROYECTO:CONTRASEÑA@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"   # [SECRETO]
# Conexión DIRECTA (puerto 5432): la usa Prisma Migrate (`prisma migrate deploy`); el pooler no admite migraciones.
DIRECT_URL="postgresql://postgres.PROYECTO:CONTRASEÑA@aws-0-REGION.pooler.supabase.com:5432/postgres"   # [SECRETO]

# ------------------------------------------------ API · núcleo y seguridad ------------------------------------------------
NODE_ENV=production                      # Vercel lo pone solo en producción
JWT_SECRET=                              # [SECRETO] ≥ 32 caracteres: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_EXPIRES_IN=7d                        # máximo 7 días
WEB_ORIGIN=https://app.tudominio.pe      # URL pública de la WEB (CORS, CSRF y cookies); varias separadas por coma
TRUST_PROXY=1                            # Vercel pone un proxy delante de la función
REGISTRO_ABIERTO=false                   # tras dar de alta a tus clientes, cierra el registro público (el KYB es manual)
# SWAPIT_ACOPIADORES=1                   # activa la herramienta para acopiadores; sin ella, marketplace comprador/vendedor

# ------------------------------------------------ API · imágenes (Supabase Storage) ------------------------------------------------
STORAGE_DRIVER=supabase                  # supabase (producción) | local (desarrollo: disco). En Vercel el disco es de solo lectura.
SUPABASE_URL=https://PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=               # [SECRETO] clave de servicio / «secret key» de Supabase. Solo en el servidor.
SUPABASE_BUCKET=lotes                    # bucket PÚBLICO de solo lectura (las escrituras las hace la API con la clave de servicio)
UPLOAD_MAX_MB=4                          # Vercel limita el cuerpo de una petición a 4,5 MB
# UPLOADS_DIR=./uploads                  # solo STORAGE_DRIVER=local
# PERMITIR_DISCO_LOCAL=1                 # solo si de verdad hay un volumen persistente (Docker/VPS); en Vercel NO

# ------------------------------------------------ API · datos de demostración ------------------------------------------------
OCULTAR_DEMO=1                           # oculta de la lista pública y del mapa los lotes de empresas marcadas como demo
# SEED_PERMITIR_PRODUCCION=1             # NUNCA en producción: permite al seed de demostración correr con NODE_ENV=production

# ------------------------------------------------ API · verificación de empresas (SUNAT) ------------------------------------------------
# Sin SUNAT_PROVIDER, en producción las empresas quedan PENDIENTES y un ADMIN las verifica a mano. El validador por defecto es un MOCK.
# SUNAT_PROVIDER=api                     # api (consulta a un proveedor real) | mock (simulado: no usar con empresas reales)
# SUNAT_API_URL=https://PROVEEDOR/ruc/{ruc}   # plantilla con {ruc}; el proveedor lo eliges tú (ver docs/despliegue.md)
# SUNAT_API_TOKEN=                       # [SECRETO] token Bearer del proveedor, si lo pide

# ------------------------------------------------ API · WhatsApp (apagado salvo que definas estas variables) ------------------------------------------------
# WHATSAPP_TOKEN=                        # [SECRETO] token de acceso de la Cloud API (sin él se usa el mock, que no envía nada)
# WHATSAPP_PHONE_NUMBER_ID=              # id del número de WhatsApp Business (no el número en sí)
# WHATSAPP_GRAPH_VERSION=v26.0           # versión de la Graph API de Meta
# WHATSAPP_VERIFY_TOKEN=                 # [SECRETO] el que escribes en la consola de Meta al configurar el webhook
# WHATSAPP_APP_SECRET=                   # [SECRETO] «App Secret» de la app de Meta: con él se valida la firma del webhook (obligatoria)

# ------------------------------------------------ API · IA (todo opcional) ------------------------------------------------
# Asistente de WhatsApp con Gemini: interpreta un mensaje libre del proveedor y arma un borrador que la persona confirma. FUERA de la demo.
# WHATSAPP_IA=off                        # on para encenderlo (necesita además GEMINI_API_KEY)
# GEMINI_API_KEY=                        # [SECRETO] clave de Google AI Studio
# GEMINI_MODEL=gemini-3.8-flash          # revisa el nombre vigente en https://ai.google.dev/gemini-api/docs/models
# GEMINI_TIMEOUT_MS=6000
# ANTHROPIC_API_KEY=                     # [SECRETO] clasificación de lotes con Claude (sin clave: clasificador local)
# ANTHROPIC_MODEL=
# OPENAI_API_KEY=                        # [SECRETO] embeddings reales (sin clave: embeddings locales por hashing)
# MAPBOX_TOKEN=                          # [SECRETO] geocodificación de direcciones exactas (sin token: ubicación aproximada por ciudad)

# ------------------------------------------------ Primera carga (solo se usan al ejecutar `pnpm primera-carga`, desde TU máquina) ------------------------------------------------
# ADMIN_EMAIL=
# ADMIN_PASSWORD=                        # [SECRETO] ≥ 12 caracteres; pásala por la línea de comandos, no la guardes en archivos

# ------------------------------------------------ Desarrollo local ------------------------------------------------
# API_PORT=4000                          # (Vercel ignora el puerto)

# ================================================ WEB (proyecto «swapit-web») ================================================
API_URL=https://swapit-api.vercel.app    # URL pública de la API; la web reenvía /api/* hacia ella. Se lee al COMPILAR: redespliega si cambia.
NEXT_PUBLIC_SUPABASE_URL=https://PROYECTO.supabase.co   # [PÚBLICO] permite a la CSP mostrar las imágenes de Supabase Storage
NEXT_PUBLIC_MAPBOX_TOKEN=                # [PÚBLICO] token público de Mapbox (opcional; sin él, teselas abiertas)
# NEXT_PUBLIC_MOSTRAR_CO2=1              # [PÚBLICO] muestra el CO₂eq (oculto mientras los factores no estén validados)
